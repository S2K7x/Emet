{
  "name": "@emet/server",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:kill": "node scripts/killtest.mjs",
    "test:meeting": "node scripts/meetingtest.mjs",
    "test:reconnect": "node scripts/reconnecttest.mjs",
    "test:map": "tsx scripts/maptest.ts",
    "test:powers": "node scripts/powerstest.mjs",
    "test:loop": "node scripts/looptest.mjs",
    "test:portals": "node scripts/portaltest.mjs",
    "test:zones": "node scripts/zonetest.mjs"
  },
  "dependencies": {
    "tsx": "^4.20.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
